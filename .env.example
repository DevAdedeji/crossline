# No environment file is needed for the default localhost demo.
# Set web variables in apps/web/.env or export in your shell.
NUXT_PUBLIC_MATCH_URL=ws://127.0.0.1:2567
# Export these before starting the match process.
MATCH_PORT=2567
MATCH_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:3000
# Hosted accounts and durable leaderboard. Export DATABASE_URL to the match server;
# packages/db/.env is only for explicit migration tooling. Local fixtures use PGlite.
# Use your own local database; no production URL or credentials belong here.
# DATABASE_URL=postgresql://localhost:5432/crossline
# Local Online FFA: defaults to 100 human seats in one shared room; allowed range 2–100.
FFA_MAX_CLIENTS=100
# PORT is accepted as a fallback when MATCH_PORT is unset (future service hosting).

# Bounded server pool; accepted range 1–5. No database is required for play.
DB_POOL_MAX=3
# Optional provider CA certificate FILE path (not certificate or password text).
# DATABASE_CA_FILE=/absolute/path/to/approved-provider-ca.pem
# Future approved hosting: web needs a PUBLIC secure match URL, e.g.
# NUXT_PUBLIC_MATCH_URL=wss://YOUR-MATCH-HOST
# WEB_ORIGIN=https://YOUR-WEB-HOST

# pnpm dev:match explicitly enables local accounts with immediate signup; no email is sent.
# AUTH_DEV_LOCAL=1
# Local account data is ignored by Git; :memory: is for disposable tests only.
# AUTH_LOCAL_PATH=/absolute/local/path/accounts
# Future approved production setup; keep these server-side and use secure entry.
# BETTER_AUTH_SECRET must be a separately approved strong secret (32+ characters).
# BETTER_AUTH_SECRET=
# Server-only proxy secret, distinct from BETTER_AUTH_SECRET; never NUXT_PUBLIC_*.
# MATCH_PROXY_SECRET=
# Web counterpart uses the SAME proxy secret; no secrets are generated here.
# NUXT_MATCH_PROXY_SECRET=
# NUXT_WEB_ORIGIN=https://YOUR-WEB-HOST
# Production fails closed on missing secure settings; provisioning and secret setup need approval.

# Signup immediately signs in; email ownership remains unverified.
# No email-provider account or email API key is required for launch.
